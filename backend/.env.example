# Set to 1 to use local SQLite (no Aiven needed). Set to 0 to use Aiven MySQL below.
USE_SQLITE=1

# Aiven MySQL (from Aiven Console > your service > Overview)
# Replace PASSWORD with your actual password (click "Reveal" in Aiven to copy)
DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-7af825f-amina-9b5c.i.aivencloud.com:19298/defaultdb?ssl-mode=REQUIRED

# JWT secret (change in production)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY_DAYS=7

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
